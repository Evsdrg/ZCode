{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Bugfix: outDir 不能是 dist。tsconfig.base 有 composite+declaration，`pnpm typecheck`
    // （tsc -b，AGENTS.md 强制要求）会真的 emit，逐文件产物正好覆盖 tsup 打进同一个 dist 的
    // bundle：entry-http.js 从 ~3.7MB 缩成 6KB、裸 import 原样保留，Node 起不来，
    // 表现为「刚重启服务就崩」。dist-types 已被 .gitignore 覆盖，且无任何项目引用本包、
    // 也没有消费方读这里的声明（tsup 未开 dts，clean 构建后 dist 下 0 个 .d.ts）。
    "outDir": "dist-types",
    "rootDir": "src",
    "lib": ["ES2022"]
  },
  "include": ["src"],
  // server 同时直接 import 了 shared / services / client / rpc。
  // 之前 references 不完整，构建时会退回到沿着包入口抓源码，造成 rpc 报错被重复放大。
  "references": [
    { "path": "../shared" },
    { "path": "../services" },
    { "path": "../client" },
    { "path": "../rpc" }
  ]
}
